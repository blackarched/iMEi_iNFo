# IMEI Tool Production Environment Configuration

# Flask Configuration
SECRET_KEY=your-super-secret-key-here-change-in-production
FLASK_ENV=production
DATABASE_PATH=/app/data/imei_tool.db

# Redis Configuration (for rate limiting)
REDIS_URL=redis://redis:6379/0

# Real Working API Keys
IMEI24_API_KEY=your_imei24_api_key_here
CHECKMEND_API_KEY=your_checkmend_api_key_here
GSMARENA_API_KEY=your_gsmarena_api_key_here
DEVICECHECK_API_KEY=your_devicecheck_api_key_here

# Security
ENCRYPTION_KEY=your-encryption-key-here
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/imei_server.log

# Rate Limiting
DEFAULT_RATE_LIMIT=200 per day, 50 per hour

# Database
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL=24h

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090